# Server-only Gemini configuration. Never prefix these names with VITE_.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash

# Added automatically by: npm run ai:setup-rag -- --write-env
# Leave blank until the knowledge upload step is complete.
GEMINI_FILE_SEARCH_STORE=

# Optional password-reset email delivery. Both values are required.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=LaneLab <noreply@lanelab.studio>
