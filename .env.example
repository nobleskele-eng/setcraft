# Optional: enables live AI Coach generation, modification and review.
# Without this key, SetCraft uses clearly labeled local simulation responses.
GEMINI_API_KEY=""

# Optional Gemini model override. The default is the current stable Flash model.
GEMINI_MODEL="gemini-3.6-flash"

# Optional public deployment URL for future callbacks and shared links.
APP_URL=""

# Local/production server port. Defaults to 3000 when omitted.
PORT="3000"
