{
  "name": "lanelab-swim-studio",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "build:cloudflare": "vinext build",
    "cloudflare:setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cloudflare.ps1",
    "deploy:cloudflare": "vinext deploy",
    "deploy:cloudflare:dry-run": "vinext deploy --dry-run",
    "start": "vinext start",
    "data:extract": "node scripts/extract-reference-data.mjs",
    "ai:setup-rag": "node --import tsx scripts/ai-setup-rag.ts",
    "ai:eval": "node --import tsx scripts/ai-eval.ts",
    "ai:audit-knowledge": "node --import tsx scripts/ai-knowledge-audit.ts",
    "ai:generate-coverage": "node --import tsx scripts/ai-generate-coverage.ts",
    "test": "npm run build && npm run test:race && npm run test:ai-policy && node --no-warnings=ExperimentalWarning --experimental-loader ./scripts/cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs",
    "test:race": "node --import tsx --test tests/race-intelligence.test.ts",
    "test:ai-policy": "node --import tsx --test tests/ai-policy-guardrails.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "release:validate": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "@google/genai": "2.16.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "LaneLab Swim Studio"
}
